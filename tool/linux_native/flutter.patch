+    if (!retained || !eglQuerySurface(retained->display, retained->surface, EGL_WIDTH, &width)) {
+      g_error("Surface retain check failed during recreation");
+    }
+    setup_opengl(self);
+    g_message("Native surface cycle complete");
+    return G_SOURCE_REMOVE;
+  }, nullptr);
+}
