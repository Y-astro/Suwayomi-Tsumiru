+static void fl_engine_dispatch_batons(FlEngine* self, uint64_t interval_nanos) {
+  g_autoptr(GArray) batons = g_array_new(FALSE, FALSE, sizeof(intptr_t));
+  {
+    g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&self->vsync_mutex);
+    g_array_append_vals(batons, self->vsync_batons->data, self->vsync_batons->len);
+    g_array_set_size(self->vsync_batons, 0);
+  }
+  if (batons->len == 0 || self->engine == nullptr) {
+    return;
+  }
+
+  uint64_t start_time = self->embedder_api.GetCurrentTime != nullptr
+                            ? self->embedder_api.GetCurrentTime()
+                            : 0;
+  uint64_t target_time = start_time + interval_nanos;
+
+  for (guint i = 0; i < batons->len; i++) {
+    intptr_t baton = g_array_index(batons, intptr_t, i);
+    self->embedder_api.OnVsync(self->engine, baton, start_time, target_time);
+    self->vsync_dispatched_count++;
+  }
+
+  gint64 now_us = g_get_monotonic_time();
+  if (self->last_vsync_log_time == 0 || now_us - self->last_vsync_log_time >= 1000000) {
+    double fps = interval_nanos > 0 ? 1000000000.0 / interval_nanos : 0.0;
+    if (g_getenv("TSUMIRU_NATIVE_TRACE")) g_message("[HIGH-REFRESH PACING] Total vsyncs: %" PRIu64 ", interval: %.2f ms (%.1f Hz target)",
+              self->vsync_dispatched_count, interval_nanos / 1000000.0, fps);
+    self->last_vsync_log_time = now_us;
+  }
+}
+
+static gboolean fl_engine_on_tick_cb(GtkWidget* widget, GdkFrameClock* clock, gpointer user_data) {
+  FlEngine* self = FL_ENGINE(user_data);
+  if (self->engine == nullptr) {
+    self->tick_callback_id = 0;
+    return G_SOURCE_REMOVE;
+  }
+
+  gint64 refresh_us = 0;
+  gdk_frame_clock_get_refresh_info(clock, gdk_frame_clock_get_frame_time(clock), &refresh_us, nullptr);
+  uint64_t interval_nanos = refresh_us > 0 ? refresh_us * 1000ULL : 16666667;
+  GdkDisplay* display = gtk_widget_get_display(widget);
+  GdkWindow* window = gtk_widget_get_window(widget);
+  if (display != nullptr && window != nullptr) {
+    GdkMonitor* monitor = gdk_display_get_monitor_at_window(display, window);
+    if (monitor == nullptr) {
+      monitor = gdk_display_get_primary_monitor(display);
+    }
+    if (monitor != nullptr) {
+      int rate_mhz = gdk_monitor_get_refresh_rate(monitor);
+      if (rate_mhz > 0) {
+        if (refresh_us <= 0) interval_nanos = 1000000000000ULL / rate_mhz;
+      }
+    }
+  }
+
+  fl_engine_dispatch_batons(self, interval_nanos);
+
+  {
+    g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&self->vsync_mutex);
+    if (self->vsync_batons->len == 0) {
+      self->tick_callback_id = 0;
+      return G_SOURCE_REMOVE;
+    }
+  }
+
+  // Request next compositor frame opportunity on parent GTK surface
+  gtk_widget_queue_draw(widget);
+  return G_SOURCE_CONTINUE;
+}
+
+static gboolean fl_engine_bootstrap_timer_cb(gpointer user_data) {
+  FlEngine* self = FL_ENGINE(user_data);
+
+  if (self->frame_clock_view != nullptr && gtk_widget_get_realized(self->frame_clock_view)) {
+    self->bootstrap_timer_id = 0;
+    if (self->tick_callback_id == 0) {
+      self->tick_callback_id = gtk_widget_add_tick_callback(
+          self->frame_clock_view, fl_engine_on_tick_cb, self, nullptr);
+    }
+    gtk_widget_queue_draw(self->frame_clock_view);
+    return G_SOURCE_REMOVE;
+  }
+
+  fl_engine_dispatch_batons(self, 16666667);
+
+  {
+    g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&self->vsync_mutex);
+    if (self->vsync_batons->len == 0) {
+      self->bootstrap_timer_id = 0;
+      return G_SOURCE_REMOVE;
+    }
+  }
+  return G_SOURCE_CONTINUE;
+}
