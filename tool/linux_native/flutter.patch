+
+#include "fl_wayland_surface.h"
+#include "presentation-time-client-protocol.h"
+
+FlWaylandSurface* fl_wayland_surface_new(FlOpenGLManager* manager,
+                                        wl_egl_window* window,
+                                        EGLSurface surface,
+                                        wl_surface* child,
+                                        wl_subsurface* subsurface,
+                                        wp_presentation* presentation) {
+  auto* self = g_new0(FlWaylandSurface, 1);
+  g_atomic_ref_count_init(&self->references);
+  self->manager = FL_OPENGL_MANAGER(g_object_ref(manager));
+  self->display = fl_opengl_manager_get_egl_display(manager);
+  self->window = window;
+  self->surface = surface;
+  self->child = child;
+  self->subsurface = subsurface;
+  self->presentation = presentation;
+  return self;
+}
+
+FlWaylandSurface* fl_wayland_surface_ref(FlWaylandSurface* self) {
+  if (self) g_atomic_ref_count_inc(&self->references);
+  return self;
+}
+
+void fl_wayland_surface_unref(FlWaylandSurface* self) {
+  if (!self || !g_atomic_ref_count_dec(&self->references)) return;
+  eglDestroySurface(self->display, self->surface);
+  wl_egl_window_destroy(self->window);
+  wl_subsurface_destroy(self->subsurface);
+  wl_surface_destroy(self->child);
+  if (self->presentation) wp_presentation_destroy(self->presentation);
+  g_object_unref(self->manager);
+  if (g_getenv("TSUMIRU_NATIVE_TRACE")) g_message("Native Wayland surface released");
+  g_free(self);
+}
