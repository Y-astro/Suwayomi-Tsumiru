+import json
+import os
+from pathlib import Path
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+
+
+class CaptureLifecycleTests(unittest.TestCase):
+    def test_flat_helper_survives_control_exit_and_java_survives_capture_exit(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            library = root / 'flat-lib'
+            library.mkdir()
+            shutil.copy2(Path(__file__).parents[1] / 'app/suwayomi_logs.py', library)
+            java = root / 'Heartbeat.java'
+            java.write_text('''
+import java.nio.file.*;
+public class Heartbeat {
+  public static void main(String[] args) throws Exception {
+    for (int i = 0; i < 300; i++) {
+      System.out.println("heartbeat=" + i);
+      Files.writeString(Path.of(args[0]), Integer.toString(i));
+      Thread.sleep(20);
+    }
+  }
+}
+''')
+            subprocess.run(['javac', '--release', '21', str(java)], check=True, capture_output=True)
+            control = root / 'control.py'
+            supervisor = Path(__file__).parents[1] / 'scripts/server_supervisor.py'
+            control.write_text('''
+import builtins, importlib.util, json, os, pathlib, sys
+original = builtins.open
+def guarded(path, *args, **kwargs):
+    if str(path).endswith('/parent_pid.txt'): raise OSError('test guard')
+    return original(path, *args, **kwargs)
+builtins.open = guarded
+spec = importlib.util.spec_from_file_location('supervisor', sys.argv[1])
+supervisor = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(supervisor)
+builtins.open = original
+root = pathlib.Path(sys.argv[2])
+supervisor._lib_dir = root / 'flat-lib'
+supervisor.HOME = root / 'home'
+supervisor.PREFIX = pathlib.Path('/usr')
+os.environ['SUWAYOMI_LOG_DIR'] = str(root / 'logs')
+proc = supervisor.launch('suwayomi', {'cmd': [sys.argv[3], '-cp', str(root), 'Heartbeat', str(root / 'heartbeat')]})
+print(json.dumps({'java':proc.pid, 'capture':supervisor.Supervisor.capture_children[-1].pid}), flush=True)
+''')
+            result = subprocess.run([sys.executable, str(control), str(supervisor), str(root), shutil.which('java')], cwd='/', check=True, capture_output=True, text=True)
+            children = json.loads(result.stdout)
+            try:
+                active = root / 'logs/suwayomi.log'
+                deadline = time.monotonic() + 3
+                while time.monotonic() < deadline and not active.exists(): time.sleep(.02)
+                self.assertTrue(active.exists(), 'Detached capture died with the control parent')
+                self.assertIn('heartbeat=', active.read_text())
+                before = int((root / 'heartbeat').read_text())
+                os.kill(children['capture'], signal.SIGTERM)
+                time.sleep(.2)
+                after = int((root / 'heartbeat').read_text())
+                self.assertGreater(after, before, 'Java stopped after its capture reader exited')
+            finally:
+                for pid in children.values():
+                    try: os.kill(pid, signal.SIGTERM)
+                    except ProcessLookupError: pass
