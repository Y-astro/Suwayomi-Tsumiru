+import gzip
+import io
+import multiprocessing
+import os
+from pathlib import Path
+import shutil
+import tempfile
+import time
+import unittest
+
+from app.suwayomi_logs import (
+    BoundedLogStore,
+    redact_sensitive_text,
+    DEFAULT_LOG_DIR,
+    SEGMENT_SIZE_BYTES,
+    TOTAL_BUDGET_BYTES,
+    MAX_ARCHIVES,
+    capture_stream,
+    read_bounded_records,
+)
+
+
+def _process_worker(log_dir, sid, count, line_len):
+    store = BoundedLogStore(log_dir, segment_size=5_000, total_budget=25_000, max_archives=4)
+    payload = "x" * line_len
+    for i in range(count):
+        store.append(sid, f"proc_{sid}_line_{i}_{payload}")
+
+
+class TestSuwayomiLogsComprehensive(unittest.TestCase):
+    def setUp(self):
+        self.tmpdir = tempfile.mkdtemp()
+        self.log_dir = os.path.join(self.tmpdir, "logs")
+
+    def tearDown(self):
+        shutil.rmtree(self.tmpdir, ignore_errors=True)
+
+    def test_constants(self):
+        self.assertEqual(TOTAL_BUDGET_BYTES, 20_000_000)
+        self.assertEqual(SEGMENT_SIZE_BYTES, 2_000_000)
+        self.assertEqual(MAX_ARCHIVES, 9)
+
+    def test_redaction_comprehensive(self):
+        cases = [
+            ("https://host?access_token=secretAAA&page=2", "https://host?access_token: [REDACTED]&page=2"),
+            ("http://user:pass@host/path", "http://[REDACTED]@host/path"),
+            ('{"password": "secretBBB"}', '{"password": "[REDACTED]"}'),
+            ('{"access_token": "secretCCC"}', '{"access_token": "[REDACTED]"}'),
+            ('"refreshToken": "secretDDD"', '"refreshToken": "[REDACTED]"'),
+            ("Cookie: id=secretCCC; theme=dark; session=abc", "Cookie: id=[REDACTED]; theme=[REDACTED]; session=[REDACTED]"),
+            ("Set-Cookie: session=xyz123; Path=/; HttpOnly", "Set-Cookie: session=[REDACTED]; Path=/; HttpOnly"),
+            ("Authorization: Bearer mySecretToken", "Authorization: Bearer [REDACTED]"),
+            ("Authorization: Basic dXNlcjpwYXNz", "Authorization: Basic [REDACTED]"),
+            ("User pass: plainSecret in text", "User pass=[REDACTED] in text"),
+        ]
+        for raw, expected in cases:
+            redacted = redact_sensitive_text(raw)
+            self.assertIn('[REDACTED]', redacted)
+            self.assertNotIn("secretAAA", redacted)
+            self.assertNotIn("secretBBB", redacted)
+            self.assertNotIn("secretCCC", redacted)
+            self.assertNotIn("secretDDD", redacted)
+            self.assertNotIn("xyz123", redacted)
+            self.assertNotIn("mySecretToken", redacted)
+            self.assertNotIn("plainSecret", redacted)
+            self.assertNotIn("user:pass", redacted)
+
+    def test_unicode_boundary_and_strict_utf8_decoding(self):
+        # segment_size = 101 bytes, total_budget = 505 bytes
+        store = BoundedLogStore(self.log_dir, segment_size=101, total_budget=505, max_archives=4)
+        store.append("probe", "漢" * 1000)
+
+        # Raw file bytes must decode strictly as UTF-8 without raising
+        raw_bytes = store.active_file.read_bytes()
+        self.assertLessEqual(len(raw_bytes), 101)
+        text = raw_bytes.decode("utf-8")
+        self.assertIn("probe", text)
+        self.assertIn("... [TRUNCATED]", text)
+
+    def test_constructor_limits_and_symlink_rejection(self):
+        with self.assertRaises(ValueError):
+            BoundedLogStore(self.log_dir, segment_size=0)
+        with self.assertRaises(ValueError):
+            BoundedLogStore(self.log_dir, segment_size=1000, total_budget=500)
+        with self.assertRaises(ValueError):
+            BoundedLogStore(self.log_dir, max_archives=-1)
+
+        # Test symlink rejection
+        sym_dir = os.path.join(self.tmpdir, "sym_logs")
+        os.makedirs(sym_dir, exist_ok=True)
+        active_sym = os.path.join(sym_dir, "suwayomi.log")
+        target_file = os.path.join(self.tmpdir, "target.txt")
+        Path(target_file).touch()
+        os.symlink(target_file, active_sym)
+
+        with self.assertRaises(ValueError):
+            BoundedLogStore(sym_dir, segment_size=1000, total_budget=5000)
+
+    def test_fail_closed_on_rotation_disk_error(self):
+        store = BoundedLogStore(self.log_dir, segment_size=100, total_budget=300, max_archives=2)
+        store.append("srv", "first line")
+        
+        # Simulate disk failure during rotation: replace _rotate_if_needed to return False
+        original_rotate = store._rotate_if_needed
+        try:
+            store._rotate_if_needed = lambda incoming: False
+            store.append("srv", "second line that fails rotation")
+            # Active file should not contain second line
+            self.assertNotIn("second line", store.read_active())
+        finally:
+            store._rotate_if_needed = original_rotate
+
+    def test_multi_process_writers_and_strict_cap(self):
+        store = BoundedLogStore(self.log_dir, segment_size=5_000, total_budget=25_000, max_archives=4)
+        procs = []
+        for i in range(4):
+            p = multiprocessing.Process(target=_process_worker, args=(self.log_dir, f"p{i}", 30, 200))
+            procs.append(p)
+            p.start()
+        for p in procs:
+            p.join(timeout=10)
+
+        total_disk = store.total_disk_bytes()
+        self.assertLessEqual(total_disk, 25_000)
+        self.assertGreater(total_disk, 0)
+
+        # Verify all files decode cleanly under strict UTF-8
+        for f in Path(self.log_dir).glob("suwayomi.log*"):
+            if f.is_file():
+                f.read_bytes().decode("utf-8")
+
+    def test_capture_stream_bounded_memory_no_newline(self):
+        store = BoundedLogStore(self.log_dir, segment_size=10_000, total_budget=50_000, max_archives=4)
+        # Giant line with no newline (200KB) followed by valid line
+        giant_stream = io.BytesIO(b"X" * (200 * 1024) + b"\nnext valid line token: mySecret\n")
+        capture_stream(giant_stream, store, "stream_test")
+
+        # Read active plus rotated archives to verify ingestion across rotation
+        all_content = store.read_active()
+        for arch in Path(self.log_dir).glob("suwayomi.log.*"):
+            if arch.is_file():
+                all_content += "\n" + arch.read_text(encoding="utf-8", errors="replace")
+
+        self.assertIn("... [TRUNCATED]", all_content)
+        self.assertIn("next valid line", all_content)
+        self.assertIn("[REDACTED]", all_content)
+        self.assertNotIn("mySecret", all_content)
+
+    def test_offline_legacy_migration(self):
+        legacy_dir = os.path.join(self.tmpdir, "suwayomi/data/logs")
+        os.makedirs(legacy_dir, exist_ok=True)
+        app_log = os.path.join(legacy_dir, "application.log")
+        with open(app_log, "w", encoding="utf-8") as f:
+            f.write("Line 1 with password=oldSecret\nLine 2\n")
+
+        app_gz = os.path.join(legacy_dir, "application_2026-10-30_0.log.gz")
+        with gzip.open(app_gz, "wt", encoding="utf-8") as gz:
+            gz.write("GZ archive line with token: gzSecret\n")
+
+        store = BoundedLogStore(self.log_dir, segment_size=10_000, total_budget=50_000, max_archives=4)
+        count = store.import_legacy_logs_offline([app_log, app_gz], home=Path(self.tmpdir))
+        self.assertEqual(count, 3)
+
+        # Original files must be deleted after success
+        self.assertFalse(os.path.exists(app_log))
+        self.assertFalse(os.path.exists(app_gz))
+
+        content = store.read_active()
+        self.assertIn("[legacy] Line 1 with password=[REDACTED]", content)
+        self.assertIn("GZ archive line with token: [REDACTED]", content)
+        self.assertNotIn("oldSecret", content)
+        self.assertNotIn("gzSecret", content)
+
+        # Second migration must be a no-op (idempotent marker exists)
+        repeat_count = store.import_legacy_logs_offline([app_log, app_gz], home=Path(self.tmpdir))
+        self.assertEqual(repeat_count, 0)
+
+
+    def test_subprocess_stream_eof_and_parent_exit(self):
+        # Verify capture companion reading from a real subprocess pipe survives and exits cleanly on EOF
+        store = BoundedLogStore(self.log_dir, segment_size=10_000, total_budget=50_000, max_archives=4)
+        r_fd, w_fd = os.pipe()
+        
+        # Companion thread/process reading r_fd
+        import subprocess, sys
+        helper_path = Path(__file__).resolve().parents[1] / "app" / "suwayomi_logs.py"
+        companion = subprocess.Popen(
+            [sys.executable, str(helper_path), "capture", "pipe_test", str(self.log_dir)],
+            stdin=r_fd,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            close_fds=True,
+        )
+        os.close(r_fd)
+
+        # Write data then close writer to signal EOF
+        with os.fdopen(w_fd, "w") as writer:
+            writer.write("message from subprocess pipe\n")
+            writer.flush()
+        
+        # Companion must terminate cleanly on EOF
+        exit_code = companion.wait(timeout=5)
+        self.assertEqual(exit_code, 0)
+
+        active = store.read_active()
+        self.assertIn("message from subprocess pipe", active)
+
+
+if __name__ == "__main__":
