+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+from unittest.mock import patch
+
+from app import suwayomi_logs as logs
+
+
+class LoggingAcceptanceTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+
+    def test_live_small_line_arrives_before_pipe_eof(self):
+        read_fd, write_fd = os.pipe()
+        helper = Path(logs.__file__)
+        child = subprocess.Popen([sys.executable, str(helper), 'capture', 'probe', str(self.root / 'logs')], stdin=read_fd)
+        os.close(read_fd)
+        try:
+            os.write(write_fd, b'live small event\n')
+            active = self.root / 'logs/suwayomi.log'
+            deadline = time.monotonic() + 1
+            while time.monotonic() < deadline and not active.exists():
+                time.sleep(.01)
+            self.assertTrue(active.exists(), 'Collector buffered a small live event until EOF')
+        finally:
+            os.close(write_fd)
+            child.wait(timeout=3)
+        self.assertEqual(child.returncode, 0)
+
+    def test_truncated_json_secret_never_reaches_disk(self):
+        text = '{"password": "' + 'private' * 12000
+        store = logs.BoundedLogStore(self.root / 'logs')
+        import io
+        logs.capture_stream(io.BytesIO(text.encode()), store, 'probe')
+        self.assertNotIn('private', store.read_active())
+
+    def test_existing_segments_are_normalized_before_append(self):
+        store = logs.BoundedLogStore(self.root / 'logs', segment_size=1000, total_budget=10000)
+        store.active_file.write_text('old event\n' * 300)
+        (store.log_dir / 'suwayomi.log.1').write_text('older event\n' * 300)
+        store.append('probe', 'new event')
+        for file in store.log_dir.glob('suwayomi.log*'):
+            self.assertLessEqual(file.stat().st_size, 1000)
+
+    def test_failed_migration_does_not_delete_history_or_mark_success(self):
+        legacy = self.root / 'suwayomi/data/logs/application.log'
+        legacy.parent.mkdir(parents=True)
+        legacy.write_text('old event\n')
+        store = logs.BoundedLogStore(self.root / 'logs')
+        with patch.object(store, '_rotate_if_needed', return_value=False):
+            with self.assertRaises((OSError, RuntimeError)):
+                store.import_legacy_logs_offline([legacy], home=self.root)
+        self.assertTrue(legacy.exists())
+        self.assertFalse(store.marker_file.exists())
+
+    def test_real_default_budget(self):
+        store = logs.BoundedLogStore(self.root / 'logs')
+        for i in range(340):
+            store.append('probe', f'event={i} ' + 'z' * 64000)
+            self.assertLessEqual(store.total_disk_bytes(), 20000000)
+        self.assertIn('event=339', store.read_active())
+        self.assertGreater(store.total_disk_bytes(), 18000000)
+
+
+if __name__ == '__main__':
+    unittest.main()
+
+class LoggingReleaseProfileTests(unittest.TestCase):
