+package suwayomi.tachidesk.manga.impl.update
+
+import kotlinx.serialization.json.Json
+import org.junit.jupiter.api.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+
+class ServerRecoveryPlanTest {
+    private val hour = 3_600_000L
+    private val completedAt = 1_000_000L
+
+    @Test
+    fun `four deadlines are anchored to completion and stop after four`() {
+        val schedule = RecoveryRetrySchedule()
+        schedule.startCycle(completedAt, setOf(1, 2))
+        assertEquals(completedAt + hour, schedule.nextDueAt)
+        assertEquals(emptySet(), schedule.claimDue(completedAt + hour - 1))
+
+        // Attempt 1: +1h
+        assertEquals(setOf(1, 2), schedule.claimDue(completedAt + hour))
+        assertEquals(completedAt + 2 * hour, schedule.nextDueAt)
+        assertEquals(emptySet(), schedule.claimDue(completedAt + hour + 1))
+
+        // Attempt 2: +2h
+        schedule.completed(1)
+        assertEquals(setOf(2), schedule.claimDue(completedAt + 2 * hour))
+        assertEquals(completedAt + 6 * hour, schedule.nextDueAt)
+
+        // Attempt 3: +6h
+        assertEquals(setOf(2), schedule.claimDue(completedAt + 6 * hour))
+        assertEquals(completedAt + 12 * hour, schedule.nextDueAt)
+
+        // Attempt 4: +12h
+        assertEquals(setOf(2), schedule.claimDue(completedAt + 12 * hour))
+        assertNull(schedule.nextDueAt)
+        assertEquals(emptySet(), schedule.claimDue(completedAt + 24 * hour))
+        assertEquals(setOf(2), schedule.targetIds)
+    }
+
+    @Test
+    fun `missed slots coalesce after sleep without repeated bursts`() {
+        val schedule = RecoveryRetrySchedule()
+        schedule.startCycle(completedAt, setOf(10))
+        assertEquals(emptySet(), schedule.claimDue(completedAt + hour, busy = true))
+        // Jump past +6h (deadline 3)
+        assertEquals(setOf(10), schedule.claimDue(completedAt + 7 * hour))
+        assertEquals(3, schedule.snapshot?.attempts)
+        assertEquals(emptySet(), schedule.claimDue(completedAt + 7 * hour + 1))
+        // Next due should be +12h
+        assertEquals(completedAt + 12 * hour, schedule.nextDueAt)
+        assertEquals(setOf(10), schedule.claimDue(completedAt + 13 * hour))
+        assertEquals(4, schedule.snapshot?.attempts)
+        assertNull(schedule.nextDueAt)
+    }
+
+    @Test
+    fun `serialized plan resumes accurately across restarts`() {
+        var saved: RecoveryRetryState? = null
+        val schedule = RecoveryRetrySchedule(save = { saved = it })
+        schedule.startCycle(completedAt, setOf(100, 200))
+        schedule.claimDue(completedAt + hour) // attempt 1 claimed
+
+        val restored = RecoveryRetrySchedule(
+            Json.decodeFromString<RecoveryRetryState>(Json.encodeToString(saved!!))
+        )
+        assertEquals(1, restored.snapshot?.attempts)
+        assertEquals(completedAt + 2 * hour, restored.nextDueAt)
+        assertEquals(emptySet(), restored.claimDue(completedAt + hour + 100))
+        assertEquals(setOf(100, 200), restored.claimDue(completedAt + 2 * hour))
+        assertEquals(2, restored.snapshot?.attempts)
+    }
+}
+
+class ExtensionUpdateScheduleTest {
+    private val hour = 3_600_000L
+
+    @org.junit.jupiter.api.Test
+    fun `initial check is due immediately when timestamp is 0`() {
+        var saved = 0L
+        val schedule = ExtensionUpdateSchedule(
+            getInitialLastCheck = { saved },
+            saveLastCheck = { saved = it },
+        )
+        kotlin.test.assertTrue(schedule.isDue(1000L, busy = false))
+        kotlin.test.assertFalse(schedule.isDue(1000L, busy = true))
+
+        schedule.markChecked(1000L)
+        kotlin.test.assertEquals(1000L, saved)
+        kotlin.test.assertFalse(schedule.isDue(1000L + 5 * hour))
+        kotlin.test.assertTrue(schedule.isDue(1000L + 6 * hour))
+    }
+
+    @org.junit.jupiter.api.Test
+    fun `persisted timestamp is respected across cycles`() {
+        var saved = 5000L
+        val schedule = ExtensionUpdateSchedule(
+            getInitialLastCheck = { saved },
+            saveLastCheck = { saved = it },
+        )
+        kotlin.test.assertEquals(5000L + 6 * hour, schedule.nextDueAt)
+        kotlin.test.assertFalse(schedule.isDue(5000L + 2 * hour))
+        kotlin.test.assertTrue(schedule.isDue(5000L + 6 * hour))
+    }
+}
