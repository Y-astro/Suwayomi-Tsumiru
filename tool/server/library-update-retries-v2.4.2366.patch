+import suwayomi.tachidesk.manga.impl.download.DownloadManager
+import suwayomi.tachidesk.manga.impl.download.model.DownloadQueueItem
+import suwayomi.tachidesk.manga.impl.download.model.DownloadState
+import suwayomi.tachidesk.manga.impl.download.model.DownloadState.Queued
+import suwayomi.tachidesk.manga.impl.download.model.Status
+import suwayomi.tachidesk.manga.impl.extension.Extension
+import suwayomi.tachidesk.manga.impl.extension.ExtensionsList
+import suwayomi.tachidesk.manga.model.table.ChapterTable
+import suwayomi.tachidesk.manga.model.table.ExtensionTable
+import suwayomi.tachidesk.manga.model.table.MangaTable
+import suwayomi.tachidesk.manga.model.table.SourceTable
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.get
+
+object ServerRecoveryManager {
+    private val logger = KotlinLogging.logger {}
+    private val preferences by lazy { Injekt.get<Application>().getSharedPreferences("server_util", Context.MODE_PRIVATE) }
+
+    private const val DOWNLOAD_RECOVERY_KEY = "downloadUpdateRetriesV1"
+    private const val EXTENSION_UPDATE_KEY = "extensionAutoUpdateLastCheckV1"
+
+    val recoveryLock = Any()
+
+    // Test overrides / hooks
+    var queueProvider: () -> List<DownloadQueueItem> = { DownloadManager.getStatus().queue }
+    var downloaderStateProvider: () -> Status = { DownloadManager.getStatus().status }
+    var downloaderStarter: () -> Unit = { DownloadManager.start() }
+    var extensionFetcher: suspend () -> Unit = { ExtensionsList.fetchExtensions() }
+    var extensionUpdater: suspend (String) -> String = { Extension.updateExtension(it) }
+
+    val downloadRetries by lazy {
+        RecoveryRetrySchedule(
+            initial =
+                runCatching {
+                    preferences.getString(DOWNLOAD_RECOVERY_KEY, null)?.let { Json.decodeFromString<RecoveryRetryState>(it) }
+                }.onFailure { logger.error(it) { "Cannot restore download retry plan" } }.getOrNull(),
+            save = { state ->
+                val editor = preferences.edit()
+                if (state == null) editor.remove(DOWNLOAD_RECOVERY_KEY) else editor.putString(DOWNLOAD_RECOVERY_KEY, Json.encodeToString(state))
+                if (!editor.commit()) logger.error { "Cannot persist download retry plan" }
+            },
+        )
+    }
+
+    val extensionSchedule by lazy {
+        ExtensionUpdateSchedule(
+            getInitialLastCheck = { preferences.getLong(EXTENSION_UPDATE_KEY, 0L) },
+            saveLastCheck = { timestamp ->
+                val editor = preferences.edit()
+                editor.putLong(EXTENSION_UPDATE_KEY, timestamp)
+                if (!editor.commit()) logger.error { "Cannot persist extension update check timestamp" }
+            },
+        )
+    }
+
+    fun onMainUpdateFinished(completedAt: Long) {
+        synchronized(recoveryLock) {
+            // Downloads can fail after the library has already finished syncing.
+            val targets = getEligibleChapterIds(failedOnly = false)
+            if (targets.isNotEmpty()) {
+                downloadRetries.startCycle(completedAt, targets)
+                logger.info { "Armed download recovery cycle for ${targets.size} queued chapters" }
+            } else {
+                downloadRetries.clear()
+            }
+        }
+    }
+
+    fun onLibraryReset() {
+        synchronized(recoveryLock) {
+            downloadRetries.clear()
+        }
+    }
+
+    fun isDownloadManagerBusy(): Boolean {
+        if (downloaderStateProvider() == Status.Started) return true
+        return queueProvider().any { it.state == DownloadState.Downloading || it.state == Queued }
+    }
+
+    fun getEligibleFailedChapterIds(): Set<Int> = getEligibleChapterIds(failedOnly = true)
+
+    private fun getEligibleChapterIds(failedOnly: Boolean): Set<Int> {
+        val currentQueue = queueProvider()
+        val errorChapterIds = currentQueue.filter { !failedOnly || it.state == DownloadState.Error }.map { it.chapterId }.toSet()
+        if (errorChapterIds.isEmpty()) return emptySet()
+
+        return transaction {
+            val eligible = (ChapterTable innerJoin MangaTable)
+                .selectAll()
+                .where {
+                    (ChapterTable.id inList errorChapterIds) and
+                        (ChapterTable.isRead eq false) and
+                        (ChapterTable.isDownloaded eq false) and
+                        (MangaTable.inLibrary eq true)
+                }
+                .map { it[ChapterTable.id].value }
+                .toSet()
+            eligible
+        }
+    }
+
+    /**
+     * Requeues the given chapter IDs if they are currently in the queue with state == Error.
+     * Never recreates missing entries.
+     */
+    fun requeueFailedChapters(chapterIds: Set<Int>): Int {
+        if (chapterIds.isEmpty() || isDownloadManagerBusy()) return 0
+        val eligible = chapterIds.intersect(getEligibleFailedChapterIds())
+        var count = 0
+        val currentQueue = queueProvider()
+        val toRequeue = currentQueue.filter { it.chapterId in eligible && it.state == DownloadState.Error }
+        for (item in toRequeue) {
+            item.state = Queued
+            item.progress = 0f
+            count++
+        }
+        if (count > 0) {
+            downloaderStarter()
+        }
+        return count
+    }
+
+    suspend fun performExtensionMaintenance(now: Long): Set<String> {
+        logger.info { "Starting 6-hour extension update check" }
+        extensionSchedule.markChecked(now)
+
+        runCatching {
+            extensionFetcher()
+        }.onFailure {
+            logger.warn(it) { "Extension repository fetch failed" }
+            return emptySet()
+        }
+
+        val installedWithUpdate = transaction {
+            ExtensionTable
+                .selectAll()
+                .where {
+                    (ExtensionTable.isInstalled eq true) and
+                        (ExtensionTable.hasUpdate eq true) and
+                        (ExtensionTable.isObsolete eq false)
+                }
+                .map { it[ExtensionTable.pkgName] }
+        }
+
+        if (installedWithUpdate.isEmpty()) {
+            logger.debug { "No installed extensions have updates" }
+            return emptySet()
+        }
+
+        val updatedPkgs = mutableSetOf<String>()
+        for (pkgName in installedWithUpdate) {
+            if (isDownloadManagerBusy()) break
+            runCatching {
+                logger.info { "Updating installed extension: $pkgName" }
+                extensionUpdater(pkgName)
+                updatedPkgs.add(pkgName)
+            }.onFailure {
+                logger.error(it) { "Failed to update extension: $pkgName" }
+            }
+        }
+        return updatedPkgs
+    }
+
+    fun recoverForUpdatedExtensions(updatedPkgs: Set<String>): Int {
+        if (updatedPkgs.isEmpty()) return 0
+        val affectedSourceIds = transaction {
+            (SourceTable innerJoin ExtensionTable)
+                .selectAll()
+                .where { ExtensionTable.pkgName inList updatedPkgs }
+                .map { it[SourceTable.id].value }
+                .toSet()
+        }
+        if (affectedSourceIds.isEmpty()) return 0
+
+        val eligibleChapterIds = getEligibleFailedChapterIds()
+        val currentQueue = queueProvider()
+        val affectedChapterIds = currentQueue
+            .filter { it.chapterId in eligibleChapterIds && it.sourceId in affectedSourceIds }
+            .map { it.chapterId }
+            .toSet()
+
+        if (affectedChapterIds.isNotEmpty()) {
+            logger.info { "Recovering ${affectedChapterIds.size} failed chapters for updated extensions: $updatedPkgs" }
+            return requeueFailedChapters(affectedChapterIds)
+        }
+        return 0
+    }
+}
