+        mockkObject(GetSource)
+        coEvery { GetSource.getSourceOrNull(any()) } returns source
+        every { source.id } returns 1L
+        coEvery { source.getMangaUpdate(any(), any(), any(), any()) } throws IllegalStateException("source offline")
