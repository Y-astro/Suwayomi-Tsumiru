+package suwayomi.tachidesk.manga.impl.update
+
+class ExtensionUpdateSchedule(
+    private val getInitialLastCheck: () -> Long,
+    private val saveLastCheck: (Long) -> Unit,
+) {
+    companion object {
+        const val INTERVAL_MS = 6 * 3_600_000L
+    }
+
+    var lastCheck: Long = getInitialLastCheck()
+        private set
+
+    val nextDueAt: Long
+        get() = if (lastCheck <= 0L) 0L else lastCheck + INTERVAL_MS
+
+    fun isDue(now: Long, busy: Boolean = false): Boolean {
+        if (busy) return false
+        if (lastCheck <= 0L) return true
+        return now >= lastCheck + INTERVAL_MS
+    }
+
+    fun markChecked(now: Long) {
+        lastCheck = now
+        saveLastCheck(now)
+    }
+}
