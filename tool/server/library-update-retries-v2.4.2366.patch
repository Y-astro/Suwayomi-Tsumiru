+
+    @AfterEach
+    fun cleanup() {
+        clearTables(ChapterTable, MangaTable, SourceTable, ExtensionTable)
+    }
+
+    private fun recoveryChapter(): Pair<Int, Int> {
+        val manga = createLibraryManga("Recovery")
+        val chapter = transaction {
+            ChapterTable.insert {
+                it[this.manga] = manga
+                it[name] = "Recovery chapter"
+                it[url] = "recovery-chapter"
+                it[sourceOrder] = 1
+                it[isRead] = false
+                it[isDownloaded] = false
+            } get ChapterTable.id
+        }.value
+        return manga to chapter
+    }
+
+    @Test
+    fun `failed extension fetch remains bounded and never restarts downloads`() = runBlocking {
+        var started = false
+        ServerRecoveryManager.downloaderStarter = { started = true }
+        ServerRecoveryManager.extensionFetcher = { error("repository unavailable") }
+        assertEquals(emptySet(), ServerRecoveryManager.performExtensionMaintenance(10_000L))
+        assertEquals(false, ServerRecoveryManager.extensionSchedule.isDue(10_000L + 3_600_000L))
+        assertEquals(false, started)
+    }
+
+    @Test
+    fun `queued downloads that fail after main completion still receive deadlines`() {
+        val (manga, chapter) = recoveryChapter()
+        val item = DownloadQueueItem(chapter, 1, manga, 1L, 0, state = DownloadState.Queued)
+        ServerRecoveryManager.queueProvider = { listOf(item) }
+        ServerRecoveryManager.onMainUpdateFinished(1000L)
+        assertEquals(setOf(chapter), ServerRecoveryManager.downloadRetries.targetIds)
+        item.state = DownloadState.Error
+        assertEquals(setOf(chapter), ServerRecoveryManager.downloadRetries.claimDue(1000L + 3_600_000L))
+        ServerRecoveryManager.onLibraryReset()
+    }
+
+    @Test
+    fun `requeue rechecks read status after eligibility snapshot`() {
+        val (manga, chapter) = recoveryChapter()
+        val item = DownloadQueueItem(chapter, 1, manga, 1L, 0, state = DownloadState.Error)
+        ServerRecoveryManager.queueProvider = { listOf(item) }
+        val eligible = ServerRecoveryManager.getEligibleFailedChapterIds()
+        transaction { ChapterTable.update({ ChapterTable.id eq chapter }) { it[isRead] = true } }
+        assertEquals(0, ServerRecoveryManager.requeueFailedChapters(eligible))
+        assertEquals(DownloadState.Error, item.state)
+    }
+
+    @Test
+    fun `requeue does not resume unrelated paused queued work`() {
+        val (manga, chapter) = recoveryChapter()
+        val item = DownloadQueueItem(chapter, 1, manga, 1L, 0, state = DownloadState.Error)
+        val paused = DownloadQueueItem(999, 2, manga, 1L, 1, state = DownloadState.Queued)
+        ServerRecoveryManager.queueProvider = { listOf(item, paused) }
+        assertEquals(0, ServerRecoveryManager.requeueFailedChapters(setOf(chapter)))
+        assertEquals(DownloadState.Error, item.state)
+    }
+
+    @Test
+    fun `eligible failed chapter filters out read, downloaded, non-library or non-error`() {
+        val inLibManga = createLibraryManga("InLib")
+        val notInLibManga = transaction {
+            MangaTable.insert {
+                it[title] = "NotInLib"
+                it[url] = "not-in-lib"
+                it[sourceReference] = 1L
+                it[inLibrary] = false
+            } get MangaTable.id
+        }.value
+
+        val (chEligible, chRead, chDownloaded, chNotInLib) = transaction {
+            val c1 = ChapterTable.insert {
+                it[manga] = inLibManga
+                it[name] = "Eligible"
+                it[url] = "c1"
+                it[sourceOrder] = 1
+                it[isRead] = false
+                it[isDownloaded] = false
+            } get ChapterTable.id
+
+            val c2 = ChapterTable.insert {
+                it[manga] = inLibManga
+                it[name] = "Read"
+                it[url] = "c2"
+                it[sourceOrder] = 2
+                it[isRead] = true
+                it[isDownloaded] = false
+            } get ChapterTable.id
+
+            val c3 = ChapterTable.insert {
+                it[manga] = inLibManga
+                it[name] = "Downloaded"
+                it[url] = "c3"
+                it[sourceOrder] = 3
+                it[isRead] = false
+                it[isDownloaded] = true
+            } get ChapterTable.id
+
+            val c4 = ChapterTable.insert {
+                it[manga] = notInLibManga
+                it[name] = "NotInLib"
+                it[url] = "c4"
+                it[sourceOrder] = 4
+                it[isRead] = false
+                it[isDownloaded] = false
+            } get ChapterTable.id
+
+            listOf(c1.value, c2.value, c3.value, c4.value)
+        }
+
+        val queue = listOf(
+            DownloadQueueItem(chEligible, 1, inLibManga, 1L, 10, state = DownloadState.Error),
+            DownloadQueueItem(chRead, 2, inLibManga, 1L, 10, state = DownloadState.Error),
+            DownloadQueueItem(chDownloaded, 3, inLibManga, 1L, 10, state = DownloadState.Error),
+            DownloadQueueItem(chNotInLib, 4, notInLibManga, 1L, 10, state = DownloadState.Error),
+        )
+        ServerRecoveryManager.queueProvider = { queue }
+
+        val eligible = ServerRecoveryManager.getEligibleFailedChapterIds()
+        assertEquals(setOf(chEligible), eligible)
+    }
+
+    @Test
+    fun `requeue failed chapters modifies only ERROR items and never recreates removed entries`() {
+        val (manga, chapter) = recoveryChapter()
+        val q1 = DownloadQueueItem(chapter, 1, manga, 1L, 0, state = DownloadState.Error)
+        ServerRecoveryManager.queueProvider = { listOf(q1) }
+        var started = false
+        ServerRecoveryManager.downloaderStarter = { started = true }
+        val requeued = ServerRecoveryManager.requeueFailedChapters(setOf(chapter, 999))
+        assertEquals(1, requeued)
+        assertEquals(DownloadState.Queued, q1.state)
+        assertEquals(true, started)
+        assertEquals(0, ServerRecoveryManager.requeueFailedChapters(setOf(999)))
+    }
+
+    @Test
+    fun `extension maintenance only updates installed extensions with update and triggers affected recovery`() = runBlocking {
+        transaction {
+            val ext1 = ExtensionTable.insert {
+                it[pkgName] = "ext.with.update"
+                it[name] = "Ext 1"
+                it[versionName] = "1.0"
+                it[versionCode] = 1L
+                it[extensionLib] = "1.4"
+                it[lang] = "en"
+                it[contentWarning] = 0
+                it[isInstalled] = true
+                it[hasUpdate] = true
+            } get ExtensionTable.id
+
+            val ext2 = ExtensionTable.insert {
+                it[pkgName] = "ext.not.installed"
+                it[name] = "Ext 2"
+                it[versionName] = "1.0"
+                it[versionCode] = 1L
+                it[extensionLib] = "1.4"
+                it[lang] = "en"
+                it[contentWarning] = 0
+                it[isInstalled] = false
+                it[hasUpdate] = true
+            } get ExtensionTable.id
+
+            val ext3 = ExtensionTable.insert {
+                it[pkgName] = "ext.up.to.date"
+                it[name] = "Ext 3"
+                it[versionName] = "1.0"
+                it[versionCode] = 1L
+                it[extensionLib] = "1.4"
+                it[lang] = "en"
+                it[contentWarning] = 0
+                it[isInstalled] = true
+                it[hasUpdate] = false
+            } get ExtensionTable.id
+
+            SourceTable.insert {
+                it[id] = 100L
+                it[name] = "Source 1"
+                it[lang] = "en"
+                it[extension] = ext1
+            }
+        }
+
+        var fetched = false
+        ServerRecoveryManager.extensionFetcher = { fetched = true }
+        val updatedList = mutableListOf<String>()
+        ServerRecoveryManager.extensionUpdater = { pkg ->
+            updatedList.add(pkg)
+            "ok"
+        }
+
+        val updated = ServerRecoveryManager.performExtensionMaintenance(System.currentTimeMillis())
+        assertEquals(setOf("ext.with.update"), updated)
+        assertEquals(listOf("ext.with.update"), updatedList)
+        assertEquals(true, fetched)
+
+        // Test recovery of affected source
+        val manga = createLibraryManga("Manga 100")
+        val chapterId = transaction {
+            ChapterTable.insert {
+                it[this.manga] = manga
+                it[name] = "Ch 1"
+                it[url] = "ch1"
+                it[sourceOrder] = 1
+                it[isRead] = false
+                it[isDownloaded] = false
+            } get ChapterTable.id
+        }.value
+
+        val item = DownloadQueueItem(chapterId, 1, manga, 100L, 5, state = DownloadState.Error)
+        ServerRecoveryManager.queueProvider = { listOf(item) }
+
+        val recoveredCount = ServerRecoveryManager.recoverForUpdatedExtensions(updated)
+        assertEquals(1, recoveredCount)
+        assertEquals(DownloadState.Queued, item.state)
+    }
+}
