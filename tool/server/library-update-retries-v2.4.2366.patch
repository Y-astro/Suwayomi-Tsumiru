+package suwayomi.tachidesk.manga.impl.update
+
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class RecoveryRetryState(
+    val completedAt: Long,
+    val targetIds: Set<Int>,
+    val attempts: Int = 0,
+) {
+    init {
+        require(completedAt >= 0 && attempts in 0..4 && targetIds.all { it > 0 })
+    }
+}
+
+class RecoveryRetrySchedule(
+    initial: RecoveryRetryState? = null,
+    private val save: (RecoveryRetryState?) -> Unit = {},
+) {
+    companion object {
+        val DEADLINES_MS = listOf(
+            1 * 3_600_000L,
+            2 * 3_600_000L,
+            6 * 3_600_000L,
+            12 * 3_600_000L,
+        )
+    }
+
+    var snapshot: RecoveryRetryState? = initial
+        private set
+
+    val targetIds: Set<Int> get() = snapshot?.targetIds.orEmpty()
+
+    val nextDueAt: Long?
+        get() = snapshot?.takeIf { it.attempts < DEADLINES_MS.size }?.let {
+            it.completedAt + DEADLINES_MS[it.attempts]
+        }
+
+    private fun replace(state: RecoveryRetryState?) {
+        if (state == snapshot) return
+        save(state)
+        snapshot = state
+    }
+
+    fun clear() = replace(null)
+
+    fun startCycle(
+        completedAt: Long,
+        ids: Set<Int>,
+    ) = replace(ids.takeIf { it.isNotEmpty() }?.let { RecoveryRetryState(completedAt, it.toSet()) })
+
+    fun completed(id: Int) = retain(targetIds - id)
+
+    fun retain(ids: Set<Int>) {
+        val state = snapshot ?: return
+        val remaining = state.targetIds.intersect(ids)
+        replace(remaining.takeIf { it.isNotEmpty() }?.let { state.copy(targetIds = it) })
+    }
+
+    fun claimDue(
+        now: Long,
+        busy: Boolean = false,
+    ): Set<Int> {
+        val state = snapshot ?: return emptySet()
+        if (busy || now < state.completedAt) return emptySet()
+        val elapsed = now - state.completedAt
+        var dueAttempt = 0
+        while (dueAttempt < DEADLINES_MS.size && elapsed >= DEADLINES_MS[dueAttempt]) {
+            dueAttempt++
+        }
+        if (dueAttempt <= state.attempts) return emptySet()
+        replace(state.copy(attempts = dueAttempt))
+        return state.targetIds
+    }
+}
