+package suwayomi.tachidesk.manga.impl.update
+
+import android.app.Application
+import android.content.Context
+import eu.kanade.tachiyomi.source.Source
+import eu.kanade.tachiyomi.source.model.SChapter
+import eu.kanade.tachiyomi.source.model.SManga
+import eu.kanade.tachiyomi.source.model.SMangaUpdate
+import io.mockk.coEvery
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.mockkObject
+import io.mockk.unmockkObject
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import kotlinx.serialization.json.Json
+import org.jetbrains.exposed.v1.core.eq
+import org.jetbrains.exposed.v1.jdbc.selectAll
+import org.jetbrains.exposed.v1.jdbc.transactions.transaction
+import org.jetbrains.exposed.v1.jdbc.update
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import suwayomi.tachidesk.manga.impl.Category
+import suwayomi.tachidesk.manga.impl.CategoryManga
+import suwayomi.tachidesk.manga.impl.Manga
+import suwayomi.tachidesk.manga.impl.util.source.GetSource
+import suwayomi.tachidesk.manga.model.table.ChapterTable
+import suwayomi.tachidesk.manga.model.table.MangaTable
+import suwayomi.tachidesk.manga.model.table.toDataClass
+import suwayomi.tachidesk.test.ApplicationTest
+import suwayomi.tachidesk.test.clearTables
+import suwayomi.tachidesk.test.createLibraryManga
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.get
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertNotEquals
+import kotlin.test.assertNull
+
+class LibraryUpdateReconciliationTest : ApplicationTest() {
+    private lateinit var updater: IUpdater
+    private var categoryId: Int? = null
+    private val source = mockk<Source>(relaxed = true)
+
+    @BeforeEach
+    fun prepare() {
+        updater = Injekt.get()
+        updater.reset()
+        mockkObject(GetSource)
+        coEvery { GetSource.getSourceOrNull(any()) } returns source
+        every { source.id } returns 1L
+        coEvery { source.getMangaUpdate(any(), any(), any(), any()) } throws IllegalStateException("source offline")
+    }
+
+    private suspend fun waitUntil(predicate: () -> Boolean) =
+        withTimeout(10_000) {
+            while (!predicate()) delay(10)
+        }
+
+    private fun status(id: Int) =
+        updater
+            .getStatus()
+            .mangaUpdates
+            .firstOrNull { it.manga.id == id }
+            ?.status
+
+    private fun fetched() =
+        SMangaUpdate(
+            SManga.create().apply {
+                title = "Repaired"
+                url = "repaired"
+            },
+            listOf(
+                SChapter.create().apply {
+                    name = "Chapter 1"
+                    url = "chapter-1"
+                    chapter_number = 1f
+                },
+            ),
+        )
+
+    @Test
+    fun `only a successful chapter database sync reconciles a failure`() =
+        runBlocking {
+            val id = createLibraryManga("Reconcile")
+            updater.addMangasToQueue(
+                transaction { MangaTable.selectAll().where { MangaTable.id eq id }.map { MangaTable.toDataClass(it) } },
+            )
+            waitUntil { status(id) == JobStatus.FAILED }
+            assertFailsWith<IllegalStateException> { Manga.updateMangaAndChapters(id, updateManga = false) }
+            assertEquals(JobStatus.FAILED, status(id))
+
+            coEvery { source.getMangaUpdate(any(), any(), any(), any()) } returns fetched()
+            Manga.updateMangaAndChapters(id, updateChapters = false)
+            assertEquals(JobStatus.FAILED, status(id))
+            Manga.updateMangaAndChapters(id, updateManga = false)
+            assertEquals(JobStatus.COMPLETE, status(id))
+            assertEquals(1, transaction { ChapterTable.selectAll().where { ChapterTable.manga eq id }.count() }.toInt())
+        }
+
+    @Test
+    fun `main completion persists failures and manual sync removes only its title`() =
+        runBlocking {
+            val first = createLibraryManga("Main first")
+            val second = createLibraryManga("Main second")
+            val category = Category.createCategory("Retry fixture").also { categoryId = it }
+            CategoryManga.addMangasToCategories(listOf(first, second), listOf(category))
+            val preferences = Injekt.get<Application>().getSharedPreferences("server_util", Context.MODE_PRIVATE)
+            val before = System.currentTimeMillis()
+            updater.addCategoriesToUpdateQueue(Category.getCategoryList(), clear = true, forceAll = true)
+            waitUntil {
+                status(first) == JobStatus.FAILED && status(second) == JobStatus.FAILED &&
+                    !updater.getStatus().isRunning && preferences.getString("libraryUpdateRetriesV1", null) != null
+            }
+            val saved = Json.decodeFromString<LibraryUpdateRetryState>(preferences.getString("libraryUpdateRetriesV1", null)!!)
+            assertEquals(setOf(first, second), saved.mangaIds)
+            assertEquals(0, saved.attempts)
+            assert(saved.completedAt in before..System.currentTimeMillis())
+
+            coEvery { source.getMangaUpdate(any(), any(), any(), any()) } returns fetched()
+            Manga.updateMangaAndChapters(first, updateManga = false)
+            val remaining = Json.decodeFromString<LibraryUpdateRetryState>(preferences.getString("libraryUpdateRetriesV1", null)!!)
+            assertEquals(setOf(second), remaining.mangaIds)
+            assertEquals(JobStatus.FAILED, status(second))
+            updater.reset()
+            assertNull(preferences.getString("libraryUpdateRetriesV1", null))
+        }
+
+    @Test
+    fun `a broken source channel leaves another source running`() =
+        runBlocking {
+            val broken = createLibraryManga("Broken channel")
+            val healthy = createLibraryManga("Healthy channel")
+            transaction { MangaTable.update({ MangaTable.id eq healthy }) { it[sourceReference] = 2 } }
+            val gate = CompletableDeferred<Unit>()
+            val otherSource = mockk<Source>(relaxed = true)
+            coEvery { GetSource.getSourceOrNull(2) } returns otherSource
+            coEvery { source.getMangaUpdate(any(), any(), any(), any()) } throws AssertionError("broken channel")
+            coEvery { otherSource.getMangaUpdate(any(), any(), any(), any()) } coAnswers {
+                gate.await()
+                fetched()
+            }
+            updater.addMangasToQueue(transaction { MangaTable.selectAll().map { MangaTable.toDataClass(it) } })
+            try {
+                waitUntil { status(broken) == JobStatus.FAILED }
+                assertNotEquals(JobStatus.FAILED, status(healthy))
+            } finally {
+                gate.complete(Unit)
+            }
+            waitUntil { status(healthy) == JobStatus.COMPLETE }
+        }
+
+    @AfterEach
+    fun cleanup() {
+        updater.reset()
+        unmockkObject(GetSource)
+        categoryId?.let { Category.removeCategory(it) }
+        clearTables(ChapterTable, MangaTable)
+    }
+}
