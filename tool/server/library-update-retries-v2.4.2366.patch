@@ -0,0 +1,76 @@
+package suwayomi.tachidesk.manga.impl.update
+
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class LibraryUpdateRetryState(
+    val completedAt: Long,
+    val mangaIds: Set<Int>,
+    val attempts: Int = 0,
+) {
+    init {
+        require(completedAt >= 0 && attempts in 0..4 && mangaIds.all { it > 0 })
+    }
+}
+
+/** Called under the updater lifecycle lock; persistence completes before dispatch. */
+class LibraryUpdateRetries(
+    initial: LibraryUpdateRetryState? = null,
+    private val save: (LibraryUpdateRetryState?) -> Unit = {},
+) {
+    companion object {
+        val DEADLINES_MS = listOf(
+            1 * 3_600_000L,
+            2 * 3_600_000L,
+            6 * 3_600_000L,
+            12 * 3_600_000L,
+        )
+    }
+
+    var snapshot: LibraryUpdateRetryState? = initial
+        private set
+
+    val failedIds: Set<Int> get() = snapshot?.mangaIds.orEmpty()
+
+    val nextDueAt: Long?
+        get() = snapshot?.takeIf { it.attempts < DEADLINES_MS.size }?.let {
+            it.completedAt + DEADLINES_MS[it.attempts]
+        }
+
+    private fun replace(state: LibraryUpdateRetryState?) {
+        if (state == snapshot) return
+        save(state)
+        snapshot = state
+    }
+
+    fun clear() = replace(null)
+
+    fun finishMainUpdate(
+        completedAt: Long,
+        failedIds: Set<Int>,
+    ) = replace(failedIds.takeIf { it.isNotEmpty() }?.let { LibraryUpdateRetryState(completedAt, it.toSet()) })
+
+    fun chapterSynced(mangaId: Int) = retain(failedIds - mangaId)
+
+    fun retain(ids: Set<Int>) {
+        val state = snapshot ?: return
+        val remaining = state.mangaIds.intersect(ids)
+        replace(remaining.takeIf { it.isNotEmpty() }?.let { state.copy(mangaIds = it) })
+    }
+
+    fun claimDue(
+        now: Long,
+        busy: Boolean = false,
+    ): Set<Int> {
+        val state = snapshot ?: return emptySet()
+        if (busy || now < state.completedAt) return emptySet()
+        val elapsed = now - state.completedAt
+        var dueAttempt = 0
+        while (dueAttempt < DEADLINES_MS.size && elapsed >= DEADLINES_MS[dueAttempt]) {
+            dueAttempt++
+        }
+        if (dueAttempt <= state.attempts) return emptySet()
+        replace(state.copy(attempts = dueAttempt))
+        return state.mangaIds
+    }
+}
