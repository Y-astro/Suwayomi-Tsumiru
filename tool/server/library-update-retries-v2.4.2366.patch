+                title = "Repaired"
+                url = "repaired"
+            },
+            listOf(
+                SChapter.create().apply {
+                    name = "Chapter 1"
+                    url = "chapter-1"
+                    chapter_number = 1f
+                },
+            ),
+        )
+
+    @Test
+    fun `only a successful chapter database sync reconciles a failure`() =
+        runBlocking {
+            val id = createLibraryManga("Reconcile")
+            updater.addMangasToQueue(
+                transaction { MangaTable.selectAll().where { MangaTable.id eq id }.map { MangaTable.toDataClass(it) } },
+            )
+            waitUntil { status(id) == JobStatus.FAILED }
+            assertFailsWith<IllegalStateException> { Manga.updateMangaAndChapters(id, updateManga = false) }
+            assertEquals(JobStatus.FAILED, status(id))
+
+            coEvery { source.getMangaUpdate(any(), any(), any(), any()) } returns fetched()
+            Manga.updateMangaAndChapters(id, updateChapters = false)
+            assertEquals(JobStatus.FAILED, status(id))
+            Manga.updateMangaAndChapters(id, updateManga = false)
+            assertEquals(JobStatus.COMPLETE, status(id))
+            assertEquals(1, transaction { ChapterTable.selectAll().where { ChapterTable.manga eq id }.count() }.toInt())
+        }
+
+    @Test
+    fun `main completion persists failures and manual sync removes only its title`() =
+        runBlocking {
+            val first = createLibraryManga("Main first")
+            val second = createLibraryManga("Main second")
+            val category = Category.createCategory("Retry fixture").also { categoryId = it }
+            CategoryManga.addMangasToCategories(listOf(first, second), listOf(category))
