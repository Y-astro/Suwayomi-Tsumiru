+package suwayomi.tachidesk.manga.impl.update
+
+import kotlinx.serialization.json.Json
+import org.junit.jupiter.api.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+
+class LibraryUpdateRetriesTest {
+    private val hour = 3_600_000L
+    private val completedAt = 1_000_000L
+
+    @Test
+    fun `both retries are anchored to main completion and stop after two`() {
+        val retries = LibraryUpdateRetries()
+        retries.finishMainUpdate(completedAt, setOf(1, 2))
+        assertEquals(completedAt + hour, retries.nextDueAt)
+        assertEquals(emptySet(), retries.claimDue(completedAt + hour - 1))
+        assertEquals(setOf(1, 2), retries.claimDue(completedAt + hour))
+        assertEquals(emptySet(), retries.claimDue(completedAt + hour + 1))
+        retries.chapterSynced(1)
+        assertEquals(setOf(2), retries.claimDue(completedAt + 2 * hour))
+        assertEquals(emptySet(), retries.claimDue(completedAt + 20 * hour))
+        assertEquals(setOf(2), retries.failedIds)
+        assertNull(retries.nextDueAt)
+    }
+
+    @Test
+    fun `serialized plan resumes without repeating an attempted slot`() {
+        var saved: LibraryUpdateRetryState? = null
+        val retries = LibraryUpdateRetries(save = { saved = it })
+        retries.finishMainUpdate(completedAt, setOf(3))
+        retries.claimDue(completedAt + hour)
+        val restored = LibraryUpdateRetries(Json.decodeFromString<LibraryUpdateRetryState>(Json.encodeToString(saved!!)))
+        assertEquals(emptySet(), restored.claimDue(completedAt + hour + 100))
+        assertEquals(setOf(3), restored.claimDue(completedAt + 2 * hour))
+    }
+
+    @Test
+    fun `missed slots coalesce and busy server does not consume an attempt`() {
+        val retries = LibraryUpdateRetries()
+        retries.finishMainUpdate(completedAt, setOf(4))
+        assertEquals(emptySet(), retries.claimDue(completedAt + hour, busy = true))
+        assertEquals(setOf(4), retries.claimDue(completedAt + 3 * hour))
+        assertEquals(emptySet(), retries.claimDue(completedAt + 3 * hour + 1))
+    }
+
+    @Test
+    fun `manual success cancels retries only for the synchronized title`() {
+        val retries = LibraryUpdateRetries()
+        retries.finishMainUpdate(completedAt, setOf(1, 2))
+        retries.chapterSynced(100)
+        retries.chapterSynced(1)
+        assertEquals(setOf(2), retries.claimDue(completedAt + hour))
+        retries.chapterSynced(2)
+        assertNull(retries.snapshot)
+        assertEquals(emptySet(), retries.claimDue(completedAt + 2 * hour))
+    }
+
+    @Test
+    fun `reset and new main completion supersede old plans`() {
+        val retries = LibraryUpdateRetries()
+        retries.finishMainUpdate(completedAt, setOf(1))
+        retries.clear()
+        assertEquals(emptySet(), retries.claimDue(completedAt + hour))
+        retries.finishMainUpdate(completedAt + hour, setOf(2))
+        assertEquals(emptySet(), retries.claimDue(completedAt + hour))
+        assertEquals(setOf(2), retries.claimDue(completedAt + 2 * hour))
+        retries.finishMainUpdate(completedAt + 2 * hour, emptySet())
+        assertNull(retries.snapshot)
+    }
+
+    @Test
+    fun `removed titles are excluded and state persists before dispatch`() {
+        var saved: LibraryUpdateRetryState? = null
+        val retries = LibraryUpdateRetries(save = { saved = it })
+        retries.finishMainUpdate(completedAt, setOf(1, 2))
+        retries.retain(setOf(2))
+        assertEquals(setOf(2), retries.claimDue(completedAt + hour))
+        assertEquals(1, saved?.attempts)
+        assertEquals(setOf(2), saved?.mangaIds)
+    }
+}
